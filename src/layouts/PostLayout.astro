---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import TopicChip from '../components/TopicChip.astro';
import { readingMinutes } from '../utils/reading';
import { SITE } from '../site.config';

interface Props {
  entry: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'> | null;
  next?: CollectionEntry<'posts'> | null;
}

const { entry, prev = null, next = null } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, date, topic, tags } = entry.data;

const reading = readingMinutes(entry.body);

const toc = headings.filter(
  (h) =>
    (h.depth === 2 || h.depth === 3) &&
    h.slug !== 'footnotes' &&
    h.slug !== 'footnote-label'
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: SITE.author },
};
---

<Base title={title} description={description} bodyClass="post-page">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="post-header">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-topic">{SITE.topics[topic].label}</span>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-cur" aria-current="page">{title}</span>
        </nav>

        <p class="overline"><span class="accent">{SITE.topics[topic].label}</span> — {SITE.topics[topic].hint}</p>
        <h1 class="display">{title}</h1>
        <p class="desc">{description}</p>
        <div class="meta-row">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span class="sep" aria-hidden="true">/</span>
          <span>{reading} min read</span>
          <span class="sep" aria-hidden="true">/</span>
          <TopicChip topic={topic} />
          {tags.map((tag) => <span class="chip meta">#{tag}</span>)}
        </div>
      </div>
    </header>

    <div class="container">
      <div class="post-wrap with-toc">
        <div class="prose">
          <Content />
          <div class="qed" aria-hidden="true"><span class="mark">∎</span></div>
        </div>

        {
          toc.length > 1 && (
            <aside class="toc" aria-label="Contents">
              <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-nav">
                <span class="toc-toggle-label">Contents</span>
                <span class="toc-caret" aria-hidden="true">▾</span>
              </button>
              <div class="toc-label">Contents</div>
              <nav id="toc-nav">
                {toc.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={{ [`lvl-${h.depth}`]: true }}
                    data-toc
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  <footer class="pn-grid container">
    {
      prev && (
        <a class="pn" href={`/blog/${prev.id.replace(/\.mdx?$/, '')}/`}>
          <span class="dir">← Older</span>
          <span class="t">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="pn" href={`/blog/${next.id.replace(/\.mdx?$/, '')}/`}>
          <span class="dir">Newer →</span>
          <span class="t">{next.data.title}</span>
        </a>
      )
    }
  </footer>

  <script>
    // collapsible table of contents on small screens
    const toc = document.querySelector('.toc');
    const tocToggle = document.querySelector('.toc-toggle');
    tocToggle?.addEventListener('click', () => {
      const open = toc?.classList.toggle('open') ?? false;
      tocToggle.setAttribute('aria-expanded', String(open));
    });
    toc?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        toc.classList.remove('open');
        tocToggle?.setAttribute('aria-expanded', 'false');
      })
    );

    // ── math tools: hover-zoom for display equations, copy LaTeX source ──
    {
      const copyText = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            return document.execCommand('copy');
          } catch {
            return false;
          } finally {
            ta.remove();
          }
        }
      };

      const flash = (btn: HTMLElement, ok: boolean) => {
        const prev = btn.textContent;
        btn.textContent = ok ? 'copied' : 'failed';
        window.setTimeout(() => {
          btn.textContent = prev;
        }, 900);
      };

      const place = (el: Element, w: number, h: number) => {
        const r = el.getBoundingClientRect();
        let x = r.left + r.width / 2 - w / 2;
        let y = r.top - h - 14;
        if (y < 10) y = r.bottom + 14;
        x = Math.max(10, Math.min(x, window.innerWidth - w - 10));
        y = Math.max(10, Math.min(y, window.innerHeight - h - 10));
        return { x, y };
      };

      // display equations → floating zoom preview with a copy button
      const tip = document.createElement('div');
      tip.className = 'math-tip';
      tip.innerHTML =
        '<button class="math-tip-copy" type="button">copy latex</button><div class="math-tip-body"></div>';
      document.body.appendChild(tip);
      const tipCopy = tip.querySelector('.math-tip-copy') as HTMLButtonElement;
      const tipBody = tip.querySelector('.math-tip-body') as HTMLDivElement;
      let tipSrc = '';
      let hideTimer = 0;

      tipCopy.addEventListener('click', () => {
        if (!tipSrc) return;
        void copyText(`\\[${tipSrc}\\]`).then((ok) => flash(tipCopy, ok));
      });
      tip.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
      tip.addEventListener('mouseleave', () => tip.classList.remove('show'));
      window.addEventListener('scroll', () => tip.classList.remove('show'), { passive: true });

      document.querySelectorAll<HTMLElement>('.prose .katex-display').forEach((eq) => {
        const holder = eq.closest<HTMLElement>('[data-latex]');
        if (!holder) return;
        const src = holder.dataset.latex || '';
        eq.addEventListener('mouseenter', () => {
          window.clearTimeout(hideTimer);
          tipSrc = src;
          const katex = eq.querySelector('.katex');
          tipBody.innerHTML = '';
          if (katex) tipBody.appendChild(katex.cloneNode(true));
          tip.classList.add('show');
          const { x, y } = place(eq, tip.offsetWidth, tip.offsetHeight);
          tip.style.transform = `translate(${x}px, ${y}px)`;
        });
        eq.addEventListener('mousemove', () => {
          if (!tip.classList.contains('show')) return;
          const { x, y } = place(eq, tip.offsetWidth, tip.offsetHeight);
          tip.style.transform = `translate(${x}px, ${y}px)`;
        });
        eq.addEventListener('mouseleave', () => {
          hideTimer = window.setTimeout(() => tip.classList.remove('show'), 260);
        });
      });

      // inline math → a small copy chip that appears on hover
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'math-chip';
      chip.textContent = 'copy';
      document.body.appendChild(chip);
      let chipTimer = 0;
      chip.addEventListener('mouseenter', () => window.clearTimeout(chipTimer));
      chip.addEventListener('mouseleave', () => chip.classList.remove('show'));
      chip.addEventListener('click', () => {
        const src = chip.dataset.latex || '';
        if (src) void copyText(`$${src}$`).then((ok) => flash(chip, ok));
      });
      window.addEventListener('scroll', () => chip.classList.remove('show'), { passive: true });

      document.querySelectorAll<HTMLElement>('.prose .katex').forEach((m) => {
        if (m.closest('.katex-display')) return; // handled above
        const holder = m.closest<HTMLElement>('[data-latex]');
        if (!holder) return;
        const src = holder.dataset.latex || '';
        m.addEventListener('mouseenter', () => {
          window.clearTimeout(chipTimer);
          const r = m.getBoundingClientRect();
          const cw = chip.offsetWidth || 64;
          const cx = Math.max(10, Math.min(r.left, window.innerWidth - cw - 10));
          chip.dataset.latex = src;
          chip.style.transform = `translate(${cx}px, ${Math.max(6, r.top - 28)}px)`;
          chip.classList.add('show');
        });
        m.addEventListener('mouseleave', () => {
          chipTimer = window.setTimeout(() => chip.classList.remove('show'), 220);
        });
      });
    }

    // scroll-spy for the table of contents
    const links: HTMLAnchorElement[] = Array.from(document.querySelectorAll('[data-toc]'));
    if (links.length) {
      const ids = links.map((a) => a.getAttribute('href')!.slice(1));
      const headings = ids
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => Boolean(el));

      const setActive = (id: string) => {
        for (const a of links) {
          a.classList.toggle('active', a.getAttribute('href') === `#${id}`);
        }
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) setActive(e.target.id);
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => io.observe(h));
    }
  </script>
</Base>
